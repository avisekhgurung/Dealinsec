{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dealinsec-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5000,
      "autoPort": true
    },
    {
      "name": "dealinsec-3000",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "PORT=3000 npm run dev"
      ],
      "port": 3000
    },
    {
      "name": "dealinsec-local-db",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "DATABASE_URL=postgresql://dealtest@localhost:5544/dealinsec_pdftest PORT=3000 npm run dev"
      ],
      "port": 3000
    },
    {
      "name": "dealinsec-prod-local",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "DATABASE_URL=postgresql://dealtest@localhost:5544/dealinsec_pdftest NODE_ENV=production PORT=5099 SESSION_SECRET=local-only-not-a-secret node dist/index.cjs"
      ],
      "port": 5099
    },
    {
      "name": "dealinsec-local-db-fake-tts",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "DATABASE_URL=postgresql://dealtest@localhost:5544/dealinsec_pdftest OPENAI_API_KEY=sk-fake-local-test OPENAI_TTS_BASE_URL=http://127.0.0.1:4010/v1 VOICE_DAILY_CHARS=3000 PORT=3000 npm run dev"
      ],
      "port": 3000
    }
  ]
}
