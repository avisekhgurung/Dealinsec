{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dealinsec-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5000,
      "autoPort": true
    },
    {
      "name": "dealinsec-3000",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "PORT=3000 npm run dev"
      ],
      "port": 3000
    },
    {
      "name": "dealinsec-local-db",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "DATABASE_URL=postgresql://dealtest@localhost:5544/dealinsec_pdftest PORT=3000 npm run dev"
      ],
      "port": 3000
    }
  ]
}
