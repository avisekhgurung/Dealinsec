# OUTREACH_FOLLOWUP_BUSINESS_DAYS  MAIL_SYNC_RETENTION_DAYS
# OPPORTUNITY_WEIGHTS  WHATSAPP_GRAPH_VERSION  PAYU_BASE_URL
