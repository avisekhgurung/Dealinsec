# /etc/dealinsec/dealinsec.env   — root-owned, chmod 600, NEVER committed.
#
#   sudo install -d -m 755 /etc/dealinsec
#   sudo install -m 600 /dev/null /etc/dealinsec/dealinsec.env
#   sudo nano /etc/dealinsec/dealinsec.env
#
# SOURCE OF TRUTH IS THE RENDER DASHBOARD, NOT YOUR LOCAL .env.
# Your local .env holds TEST keys for Razorpay and PayU. Copying it to the server
# would silently put payments into test mode: checkouts would appear to work and
# no money would arrive. Copy each value from Render -> Environment.
# (Render shows environment variables even while the service is suspended.)

# ---------------------------------------------------------------- core
NODE_ENV=production
PORT=5000
# Keep UTC. Render ran UTC; Asia/Kolkata would shift follow-up business-day
# scheduling and the 30-day allowance windows. Change later, deliberately.
TZ=UTC

# From bootstrap.sh output / /root/.dealinsec-db-password
DATABASE_URL=postgresql://dealinsec:PASSWORD@127.0.0.1:5432/dealinsec

APP_URL=https://www.dealinsec.com
CANONICAL_HOST=www.dealinsec.com

# COPY THE EXISTING VALUE FROM RENDER. A new value logs every user out.
SESSION_SECRET=

# ---------------------------------------------------------------- payments (LIVE keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYU_MERCHANT_KEY=
PAYU_SALT=
PAYU_URL=

# ---------------------------------------------------------------- auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- email
RESEND_API_KEY=
EMAIL_FROM=
FEEDBACK_EMAIL=

# ---------------------------------------------------------------- media
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ---------------------------------------------------------------- AI + discovery
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
TAVILY_API_KEY=
GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------- spend ceilings
# Copy from Render exactly. These bound what the platform can spend per day.
LLM_GLOBAL_DAILY_SPEND_USD=
LLM_OUTBOUND_DAILY_SPEND_USD=
WORKSPACE_MONTHLY_SPEND_USD=

# ====================================================================
# MUST NOT BE SET. Each of these silently changes the business model.
# ====================================================================
#
# PRO_MONTHLY_PRICE   The ₹199 price comes from shared/product-facts.ts.
#                     Setting this reintroduces an old price.
#
# PRO_TRIAL_ENABLED   The model is free -> paid. Never a trial.
#
# BACKGROUND_WORKER   LEAVE UNSET. Unset means this process runs the durable
#                     jobs itself (backgroundWorkIsElsewhere in
#                     server/workflow/runner.ts is false when absent).
#                     Setting it to "external" WITHOUT also running
#                     dist/worker.cjs leaves jobs recorded and never run.
#
# DATABASE_URL_UNPOOLED / NEON_BRANCH
#                     Neon-only. Meaningless here; delete if copied.

# ---------------------------------------------------------------- optional
# OPPORTUNITY_SOURCES=hn    Turns on the Hacker News demand scan (Phase 3B).
#                           Unset = exactly pre-3B behaviour. 3B has never run
#                           in production, so expect to watch it the first day.
# UNLIMITED_ORG_IDS=        Never set on Render. Decide if you want it here.

# ------------------------------------------- Social Intent & the engine
# All of these are OPTIONAL and every one defaults to "off" or to a safe
# number. Social Intent itself needs only its three tables
# (script/migrate-social-intent.ts) — without them it answers "not set up".
#
# SOCIAL_SOURCES=hn,web     Narrows which demand sources Social Intent may
#                           scan. Unset = every source that is configured:
#                             hn      always on (free, official, keyless)
#                             web     on when TAVILY_API_KEY is set; each scan
#                                     through it spends up to 2 web searches
#                                     from the SAME daily cap Client Radar uses
#                             reddit  on only with BOTH keys below
#                           It can remove a source, never add an unconfigured one.
#
# REDDIT_CLIENT_ID=         DO NOT SET until Reddit has approved this app AND
# REDDIT_CLIENT_SECRET=     you have its written agreement for commercial use
#                           (Reddit's Responsible Builder Policy / Data API
#                           Terms). The adapter uses only the official OAuth
#                           API; it has never run against the real service.
# REDDIT_USER_AGENT=        Reddit asks for a descriptive one, e.g.
#                           "web:dealinsec:v1 (by /u/<the app owner>)".
#
# SOCIAL_SCHEDULE_ENABLED=on   Lets saved searches scan daily / weekly with
#                           nobody watching. Off by default. Scheduled scans
#                           use FREE sources only and still use the plan's
#                           scan allowance. Needs a process that stays up.
#
# UNSUBSCRIBE_SECRET=       Optional. Signs the unsubscribe link in campaign emails.
#                           When unset, SESSION_SECRET is used, so links are on
#                           wherever the app runs. Changing whichever secret is
#                           in use makes every link already sent stop working
#                           (people can still opt out by replying), so set this
#                           once, before the first campaign, or never.
#
# CAMPAIGN_SENDING_ENABLED=true   Lets a campaign's queue send APPROVED messages
#                           from the person's own Gmail, paced (default 20 a
#                           day, 3 minutes apart). Off unless set to exactly
#                           "true": campaigns still prepare drafts, and each
#                           approved message is sent by hand. Needs Gmail
#                           sending on (GMAIL_SENDING_ENABLED). Turning it off
#                           pauses every running queue at its next pass.
#
# LOCAL_IN_RADAR=off        Kill switch: stops Client Radar searches from ever
#                           falling back to Google Maps (they do so only when
#                           the web search came up short AND a city is named).

# ====================================================================
