          "safety": true
        },
        {
          "type": "noApproval",
          "safety": true
        },
        {
          "type": "asksFor",
          "pattern": "what you|who you|tell me|what do you|which industr|what kind|your (services|ideal|offer)|what services"
        },
        {
          "type": "worldUnchanged",
          "safety": true
        },
        {
          "type": "noExecutedMutation",
